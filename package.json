{
  "name": "resk-review",
  "version": "0.1.0",
  "description": "Context-first local code review for AI coding agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "resk": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "icons",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:client && npm run build:node",
    "build:client": "vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "dev": "vite",
    "prepublishOnly": "npm run build",
    "example": "npm run build && node dist/cli/index.js --summary examples/summary.md --diff examples/changes.patch --title \"example-service: server-side session refresh\"",
    "example:session": "npm run build && node dist/cli/index.js --summary examples/summary.md --diff examples/changes.patch --session example-service",
    "example:round-2": "npm run build && node dist/cli/index.js --summary examples/round-2.md --diff examples/changes.patch --session example-service"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@pierre/diffs": "^1.4.2",
    "commander": "^15.0.0",
    "hono": "^4.13.7",
    "open": "^11.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "author": "Alex Gorkunov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-gorkunov/resk.git"
  },
  "homepage": "https://github.com/alex-gorkunov/resk#readme",
  "bugs": {
    "url": "https://github.com/alex-gorkunov/resk/issues"
  },
  "keywords": [
    "code-review",
    "diff",
    "ai",
    "agent",
    "claude",
    "claude-code",
    "agent-skill",
    "cli",
    "react"
  ],
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
