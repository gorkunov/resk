+++ b/src/auth/refresh.ts
@@ -0,0 +1,32 @@
+import { createHash, randomBytes } from 'node:crypto';
+import type { Clock } from '../utils/clock';
+
+export interface RefreshToken {
+  /** SHA-256 of the opaque secret handed to the client. The secret itself is never stored. */
+  hash: string;
+  /** Seconds since the epoch. */
+  expiresAt: number;
+}
+
+export const REFRESH_TOKEN_BYTES = 32;
+
+export function hashSecret(secret: string): string {
+  return createHash('sha256').update(secret).digest('hex');
+}
+
+export function issueRefreshToken(
+  clock: Clock,
+  ttlSeconds: number,
+): { secret: string; token: RefreshToken } {
+  const secret = randomBytes(REFRESH_TOKEN_BYTES).toString('base64url');
+  return {
+    secret,
+    token: { hash: hashSecret(secret), expiresAt: clock.now() + ttlSeconds },
+  };
+}
+
+/** Every successful refresh replaces the token, so a leaked secret is only usable once. */
+export function rotateRefreshToken(previous: RefreshToken, clock: Clock): RefreshToken {
+  const remaining = previous.expiresAt - clock.now();
+  return issueRefreshToken(clock, remaining).token;
+}
