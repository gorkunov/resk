new file mode 100644
index 0000000..fc47e96
--- /dev/null
+++ b/src/middleware/rate-limit.ts
@@ -0,0 +1,28 @@
+import type { RequestHandler } from 'express';
+
+interface Options {
+  windowMs?: number;
+  max: number;
+}
+
+/** Fixed-window limiter keyed by client IP. Enough for a single instance; not shared across replicas. */
+export function rateLimit({ windowMs = 60_000, max }: Options): RequestHandler {
+  const hits = new Map<string, { count: number; resetAt: number }>();
+  return (req, res, next) => {
+    const key = req.ip ?? 'unknown';
+    const now = Date.now();
+    const entry = hits.get(key);
+    if (!entry || entry.resetAt <= now) {
+      hits.set(key, { count: 1, resetAt: now + windowMs });
+      next();
+      return;
+    }
+    entry.count += 1;
+    if (entry.count > max) {
+      res.setHeader('Retry-After', Math.ceil((entry.resetAt - now) / 1000));
+      res.status(429).json({ error: 'too many requests' });
+      return;
+    }
+    next();
+  };
+}
