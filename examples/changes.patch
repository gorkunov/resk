@@ -0,0 +1,24 @@
+import { Router } from 'express';
+import { hashSecret } from '../auth/refresh';
+import { rateLimit } from '../middleware/rate-limit';
+import { SessionExpiredError } from '../services/user';
+
+export const authRouter = Router();
+
+authRouter.post('/refresh', rateLimit({ max: 10 }), async (req, res) => {
+  const secret = req.body?.refreshToken;
+  if (typeof secret !== 'string') {
+    res.status(400).json({ error: 'refreshToken is required' });
+    return;
+  }
+  try {
+    const session = await req.services.users.refreshSession({ hash: hashSecret(secret), expiresAt: 0 });
+    res.json({ session });
+  } catch (error) {
+    if (error instanceof SessionExpiredError) {
+      res.status(401).json({ error: 'session expired' });
+      return;
+    }
+    throw error;
+  }
+});
