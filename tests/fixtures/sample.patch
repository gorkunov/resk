+import { Router } from 'express';
+import { rateLimit } from '../middleware/rate-limit';
+
+export const authRouter = Router();
+
+authRouter.post('/auth/refresh', rateLimit({ max: 10 }), async (req, res) => {
+  const session = await req.services.users.refreshSession(req.body.token);
+  res.json({ session });
+});
